{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://wesjjdjmlnfjihkkgzfp.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "meu-nino",
      "version": "0.1.0",
      "title": "Meu Nino"
    },
    "tools": [
      {
        "name": "list_transactions",
        "title": "Listar lançamentos",
        "description": "Lista os lançamentos financeiros (receitas e despesas) do usuário autenticado, do mais recente para o mais antigo, com filtros opcionais de período e tipo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": "Data inicial em YYYY-MM-DD."
            },
            "to": {
              "type": "string",
              "description": "Data final em YYYY-MM-DD."
            },
            "type": {
              "type": "string",
              "enum": [
                "income",
                "expense",
                "transfer"
              ],
              "description": "Tipo do lançamento."
            },
            "search": {
              "type": "string",
              "description": "Texto para buscar na descrição."
            },
            "limit": {
              "type": "number",
              "description": "Quantidade máxima de lançamentos (padrão 50, máximo 200)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "monthly_summary",
        "title": "Resumo do mês",
        "description": "Resume o mês do usuário autenticado: total de receitas, total de despesas, saldo do período e as maiores categorias de gasto (regra comportamental única do Meu Nino).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "month": {
              "type": "string",
              "description": "Mês no formato YYYY-MM. Padrão: mês atual."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_accounts_and_categories",
        "title": "Listar contas e categorias",
        "description": "Lista as contas ativas e as categorias do usuário autenticado, com seus identificadores. Use antes de registrar um lançamento para escolher conta e categoria.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "create_transaction",
        "title": "Registrar lançamento",
        "description": "Registra uma despesa ou receita confirmada na conta do usuário autenticado. Informe conta por nome ou identificador. Só envie category quando o usuário tiver indicado explicitamente uma categoria; esse valor será tratado como hint e revalidado pelo Category Truth V2.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "description": "Valor positivo do lançamento."
            },
            "description": {
              "type": "string",
              "description": "Descrição do lançamento."
            },
            "type": {
              "type": "string",
              "enum": [
                "expense",
                "income"
              ],
              "description": "Tipo do lançamento."
            },
            "occurred_at": {
              "type": "string",
              "description": "Data em YYYY-MM-DD. Padrão: hoje."
            },
            "account": {
              "type": "string",
              "description": "Nome ou identificador da conta."
            },
            "category": {
              "type": "string",
              "description": "Categoria explicitamente informada pelo usuário; será revalidada pelo motor central."
            }
          },
          "required": [
            "amount",
            "description",
            "type"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "financial_position",
        "title": "Posição financeira",
        "description": "Mostra a posição financeira reconciliada do usuário autenticado: cartões com obrigação atual (inclusive cartões inativos), parcelas futuras, dívidas fora do cartão e metas em andamento.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_card_statements",
        "title": "Listar faturas de cartão",
        "description": "Lista faturas conciliadas do usuário, com cartão, vencimento, total, valor pago, saldo e status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "open",
                "partially_paid",
                "paid",
                "overdue",
                "needs_review"
              ]
            },
            "limit": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "settle_card_statement",
        "title": "Registrar pagamento de fatura",
        "description": "Registra a baixa contábil de uma fatura após confirmação explícita do usuário. Reduz caixa e obrigação; não cria uma nova despesa de consumo.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "statement_id": {
              "type": "string",
              "format": "uuid",
              "description": "Identificador retornado por list_card_statements."
            },
            "account_id": {
              "type": "string",
              "format": "uuid",
              "description": "Conta usada no pagamento."
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Valor pago. Se omitido, quita o saldo em aberto."
            },
            "paid_at": {
              "type": "string",
              "description": "Data YYYY-MM-DD."
            },
            "confirmed_by_user": {
              "type": "boolean",
              "const": true,
              "description": "Só use true após o usuário confirmar claramente valor, conta e data."
            },
            "idempotency_key": {
              "type": "string",
              "minLength": 8,
              "description": "Chave única e estável para impedir pagamento duplicado em retries."
            }
          },
          "required": [
            "statement_id",
            "account_id",
            "confirmed_by_user",
            "idempotency_key"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
